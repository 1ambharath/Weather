<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted API key from cloud backup -->
        <exclude domain="sharedpref" path="secure_groq_storage.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted API key from device transfers -->
        <exclude domain="sharedpref" path="secure_groq_storage.xml"/>
    </device-transfer>
</data-extraction-rules>