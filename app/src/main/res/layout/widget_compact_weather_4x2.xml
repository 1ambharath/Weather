<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_compact_glass"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="9dp">

    <!-- Left Column: Location & Live Telemetry -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="6dp">

        <!-- Location Navigation Header (Up / Location Title & Index / Down) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_widget_prev"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous Location"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_up" />

            <TextView
                android:id="@+id/tv_widget_location_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Bangkok (1/3)"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_widget_next"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next Location"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_down" />
        </LinearLayout>

        <!-- Main Temp & Current Condition Glyph -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33°"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_widget_condition_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Weather Condition"
                android:src="@drawable/ic_wx_thunderstorm" />

            <TextView
                android:id="@+id/tv_widget_condition_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Thunderstorm"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Sub-metrics Row (Feels Like, AQI, Rain % and Quick Refresh) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_widget_submetrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Feels 38° · AQI 42 · 🌧️ 85%"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="normal" />

            <ImageButton
                android:id="@+id/btn_widget_refresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh Weather"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Column: 4 Dynamic Hourly Outlook Cards -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Hourly Card 1 -->
        <LinearLayout
            android:id="@+id/card_hourly_1"
            android:layout_width="48dp"
            android:layout_height="76dp"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_widget_compact_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_hourly_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_hourly_icon_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Hourly Condition"
                android:src="@drawable/ic_wx_thunderstorm" />

            <TextView
                android:id="@+id/tv_hourly_temp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hourly_pop_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textColor="#38BDF8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Hourly Card 2 -->
        <LinearLayout
            android:id="@+id/card_hourly_2"
            android:layout_width="48dp"
            android:layout_height="76dp"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_widget_compact_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_hourly_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:00"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_hourly_icon_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Hourly Condition"
                android:src="@drawable/ic_wx_thunderstorm" />

            <TextView
                android:id="@+id/tv_hourly_temp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hourly_pop_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textColor="#38BDF8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Hourly Card 3 -->
        <LinearLayout
            android:id="@+id/card_hourly_3"
            android:layout_width="48dp"
            android:layout_height="76dp"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_widget_compact_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_hourly_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:00"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_hourly_icon_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Hourly Condition"
                android:src="@drawable/ic_wx_rain" />

            <TextView
                android:id="@+id/tv_hourly_temp_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="31°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hourly_pop_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="65%"
                android:textColor="#38BDF8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Hourly Card 4 -->
        <LinearLayout
            android:id="@+id/card_hourly_4"
            android:layout_width="48dp"
            android:layout_height="76dp"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_widget_compact_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_hourly_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:00"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_hourly_icon_4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Hourly Condition"
                android:src="@drawable/ic_wx_cloudy" />

            <TextView
                android:id="@+id/tv_hourly_temp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hourly_pop_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30%"
                android:textColor="#38BDF8"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
